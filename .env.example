# Default API (axios); boleh localhost untuk dev cepat
VITE_API_URL=http://localhost:3001 # Backend URL

# Opsional: URL publik yang sama dengan tunnel ngrok Anda. Dipakai HANYA untuk membuka
# /auth/github di browser (harus sama host dengan GITHUB_CALLBACK_URL di backend).
# Kalau kosong, pakai URL instance yang aktif (seringnya masih localhost).
# VITE_OAUTH_API_BASE=https://your.backend.url
